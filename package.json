    "AGENT_COMPATIBILITY.md",
    "PROJECT_PROFILE.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "LICENSE-DOCS.md",
    ".cursor",
    ".github/copilot-instructions.md",
